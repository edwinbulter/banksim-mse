<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>nl.banksim</groupId>
    <artifactId>banksim-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>BankSim-MSE backend</name>

    <modules>
        <module>bank-domain</module>
        <module>bank-api</module>
        <module>bank-bff</module>
        <module>bank-seed</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring Cloud 2025.1.x hoort bij Spring Boot 4.0.x; alleen voor de gateway in bank-bff (ADR 0008) -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <!-- Bewaking van ADR 0010: properties voor Bedrag en Iban, geen double/float in geldcode -->
        <jqwik.version>1.10.1</jqwik.version>
        <archunit.version>1.5.1</archunit.version>

        <jib-maven-plugin.version>3.5.2</jib-maven-plugin.version>

        <!-- Distroless Java 21, draait als non-root -->
        <jib.from.image>gcr.io/distroless/java21-debian13:nonroot@sha256:0a1f5a75661918de9c0813f287f651c3bf2d6dd752eada5f084eb0c1f14ced9e</jib.from.image>
        <image.tag>dev</image.tag>
        <!-- Alleen de applicatiemodules zetten dit op false -->
        <jib.skip>true</jib.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>nl.banksim</groupId>
                <artifactId>bank-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                        </includes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>${jib-maven-plugin.version}</version>
                    <configuration>
                        <from>
                            <image>${jib.from.image}</image>
                        </from>
                        <to>
                            <!-- Eigen naam, zodat de images niet botsen met die van het origineel op dezelfde node (ADR 0004) -->
                            <image>banksim-mse/${project.artifactId}:${image.tag}</image>
                        </to>
                        <container>
                            <user>65532:65532</user>
                            <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                        </container>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
