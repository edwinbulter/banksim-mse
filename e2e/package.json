{
  "name": "banksim-mse-e2e",
  "private": true,
  "description": "Acceptatietests voor BankSim-MSE: Playwright-specs met een interne DSL (doc/werkwijze-mse.md, hoofdstuk 5)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
